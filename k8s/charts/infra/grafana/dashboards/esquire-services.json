{
 "uid": "esq-services",
 "title": "Esquire Services -- REST / JVM / Pool / CPU / BFF / DB / KC",
 "tags": [
  "esquire",
  "o11y"
 ],
 "timezone": "",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "application",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "esq-prometheus"
    },
    "query": "label_values(up, application)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
