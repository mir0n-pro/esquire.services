<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pro.mir0n.esquire</groupId>
        <artifactId>esquire-parent</artifactId>
<!--xxx: we need a stable parent version to be referenced correctly -->
        <version>1.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>pro.mir0n</groupId>
    <artifactId>mir0n-utils</artifactId>
    <version>${utils.version}</version>

    <name>Mir0nUtils</name>
    <description>Base library, no Esquire inside: pro.mir0n.utils -- the queue rig / worker pool, the taijitu
        two-monad rig, and the host instance identity. The bottom of the stack: mir0n-utils, then
        esquire-messaging, then esquire-common, then the services.</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- logging API only. Nothing here knows Spring, JPA, OpenTelemetry or Esquire. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
    </build>

</project>
