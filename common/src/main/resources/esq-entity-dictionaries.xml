    <!-- Organization -->
        <dictionary>
            <kind>20</kind>
            <layers>
                <layer>
                    <layer>1</layer>
                    <title>Generic</title>
                    <fields>
                        <field>
                            <name>name</name>
                            <sort>1</sort>
                            <label>Name</label>
                            <type>string</type>
                            <tooltip>Organization short name. No special characters</tooltip>
                            <readwrite>3</readwrite>
                            <nullable>N</nullable>
                            <readwrite>3</readwrite>
                            <minmax>50</minmax>
                            <validation>^[a-zA-Z0-9 ']+$</validation>
