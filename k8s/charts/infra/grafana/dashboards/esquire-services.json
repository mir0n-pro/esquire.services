   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "stat",
   "title": "Services scraped (up)",
   "datasource": {
    "type": "prometheus",
    "uid": "esq-prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "esq-prometheus"
     },
     "expr": "sum(up)"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Total request rate (req/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "esq-prometheus"
   },
