    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "esq-prometheus"
     },
     "expr": "sum by (application, instance) (rate(http_server_requests_seconds_count{application=~\"$application\"}[1m]))",
     "legendFormat": "{{application}} {{instance}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "HTTP p95 latency by replica",
   "datasource": {
    "type": "prometheus",
    "uid": "esq-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
