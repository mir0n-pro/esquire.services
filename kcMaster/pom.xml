<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pro.mir0n.esquire</groupId>
        <artifactId>esquire-parent</artifactId>
<!-- xxx: we need a stable parent version to be referenced correctly -->
        <version>1.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>esquire-kc-master</artifactId>
    <version>${kcMaster.version}</version>

    <url/>

    <name>kcMaster</name>
    <description>KC Master (Keycloak sync) Microservice</description>

    <dependencies>
        <dependency>
            <groupId>pro.mir0n.esquire</groupId>
            <artifactId>esquire-common</artifactId>
            <version>${common.version}</version>
        </dependency>
        <dependency>
            <groupId>pro.mir0n.esquire</groupId>
            <artifactId>esquire-messaging</artifactId>
            <version>${messaging.version}</version>
        </dependency>

        <!-- tp-activemq hosts the shared JMS helper (messaging.jms.Utils) used by the KC request/response bus -->
        <dependency>
            <groupId>pro.mir0n.esquire</groupId>
            <artifactId>esquire-tp-activemq</artifactId>
            <version>${tp.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-admin-client</artifactId>
            <version>26.0.7</version>
        </dependency>

        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- Second artifact: a PLAIN classes jar (esquire-kc-master-classes.jar) beside the
                 executable one. repackage keeps the fat jar under its own name; this one carries the
                 classes at the root so a composed service (Mesnie) can depend on kcMaster's code:
                 the identity gateway implementation lives here. application.yml and logback-spring.xml
                 are left out on purpose: they belong to the kcMaster PROCESS, and on a shared classpath
                 Spring would silently take whichever copy it found first. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>classes-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>classes</classifier>
                            <excludes>
                                <exclude>application.yml</exclude>
                                <exclude>logback-spring.xml</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
