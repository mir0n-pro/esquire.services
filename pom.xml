    <profiles>
        <!-- On-demand API-doc generation for the reusable LIBRARY modules only (common, messaging,
             dataKeep, audit, tp-*). Not bound to the normal build lifecycle: run it explicitly with
             make-javadoc.bat (mvn -Pjavadoc javadoc:javadoc ...). Output lands OUTSIDE target, under
             doc/java-doc/<artifactId>, so the generated reference is a visible, browsable deliverable.
             doclint is off: the goal is an API reference, not a comment-police gate that fails the build. -->
        <profile>
            <id>javadoc</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc.version}</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                            <failOnError>false</failOnError>
                            <encoding>UTF-8</encoding>
                            <docencoding>UTF-8</docencoding>
                            <charset>UTF-8</charset>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

