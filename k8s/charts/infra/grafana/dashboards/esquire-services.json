    "h": 5,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "esq-prometheus"
     },
     "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\"}[1m]))"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "HTTP request rate by replica",
   "datasource": {
    "type": "prometheus",
