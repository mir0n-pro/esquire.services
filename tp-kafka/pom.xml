<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pro.mir0n.esquire</groupId>
        <artifactId>esquire-parent</artifactId>
        <version>1.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>esquire-tp-kafka</artifactId>
    <version>${tp.version}</version>

    <name>tp-kafka</name>
    <description>Transport provider (tp) -- Kafka. Generic publish/consume over the transport seam.</description>

    <dependencies>
        <dependency>
            <groupId>pro.mir0n.esquire</groupId>
            <artifactId>esquire-common</artifactId>
            <version>${common.version}</version>
        </dependency>

        <!-- KafkaTemplate + ConsumerFactory + listener container -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- @AutoConfiguration / @ConditionalOnClass (spring-kafka is not a Boot starter, so add these
             explicitly; tp-activemq / tp-redis get them transitively from their spring-boot-starter-*) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
    </build>

</project>
