{
 "uid": "esq-services",
 "title": "Esquire Services -- REST / JVM / Pool / CPU / BFF / DB / KC / Bus / Latency",
 "tags": [
  "esquire",
  "o11y"
 ],
 "timezone": "",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "application",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "esq-prometheus"
    },
    "query": "label_values(up, application)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Overview",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "stat",
   "title": "Services scraped (up)",
   "datasource": {
    "type": "prometheus",
    "uid": "esq-prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "esq-prometheus"
     },
     "expr": "sum(up)"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Total request rate (req/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "esq-prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "esq-prometheus"
     },
     "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\"}[1m]))"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "HTTP request rate by replica",
   "datasource": {
    "type": "prometheus",
    "uid": "esq-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10
     },
     "unit": "reqps",
     "min": 0
