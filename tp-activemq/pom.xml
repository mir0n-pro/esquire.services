<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pro.mir0n.esquire</groupId>
        <artifactId>esquire-parent</artifactId>
        <version>1.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>esquire-tp-activemq</artifactId>
    <version>${tp.version}</version>

    <name>tp-activemq</name>
    <description>Transport provider (tp) -- ActiveMQ. Generic publish/consume over the transport seam.</description>

    <dependencies>
        <dependency>
            <groupId>pro.mir0n.esquire</groupId>
            <artifactId>esquire-common</artifactId>
            <version>${common.version}</version>
        </dependency>
        <dependency>
            <groupId>pro.mir0n.esquire</groupId>
            <artifactId>esquire-messaging</artifactId>
            <version>${messaging.version}</version>
        </dependency>

        <!-- ActiveMQ client + spring-jms (JmsTemplate, DefaultMessageListenerContainer) + autoconfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-activemq</artifactId>
        </dependency>

        <!-- test only: an embedded ActiveMQ broker, so the broker-enforced noLocal own-exclusion is verified for
             real (a shared-connection consumer does NOT get its own publications; a separate one does). -->
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>activemq-broker</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
    </build>

</project>
