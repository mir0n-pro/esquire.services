<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="http://java.sun.com/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/persistence/orm http://java.sun.com/xml/ns/persistence/orm_2_0.xsd"
    version="2.0">

    <named-native-query name="EsqAcctTransactionJpa.insertAcctTransaction">
        <query>
 INSERT INTO esq_acct_transaction (
  atr_pk, atr_pk_tx, atr_acc_pk, atr_at_pk
 ,atr_amt, atr_prev_balance
 ,atr_desc
 ,atr_ref_code, atr_ref_code2, atr_ref_code3, atr_ref_code4
 ,atr_memo
 ,atr_crl_id, atr_req_id, atr_uid
 ,atr_amt_incoming, atr_ccy_incoming, atr_conv_rate
 ) VALUES (
  :pk, :pkTx, :accPk, :atPk
 ,:amt, :prevBalance
 ,:desc
 ,:refCode, :refCode2, :refCode3, :refCode4
 ,:memo
 ,:crlId, :reqId, :uid
 ,:amtIncoming, :ccyIncoming, :convRate
 )
        </query>
    </named-native-query>

    <named-native-query name="EsqAcctTransactionJpa.deleteAcctTransactionsByAccPk">
        <query>
 DELETE FROM esq_acct_transaction WHERE atr_acc_pk = :accPk
        </query>
    </named-native-query>

    <sql-result-set-mapping name="EsqAcctTransactionJpaMapping">
        <entity-result entity-class="pro.mir0n.esquire.pacMan.acct.jpa.EsqAcctTransactionJpa">
            <field-result name="id"          column="atr_pk"/>
            <field-result name="pkTx"        column="atr_pk_tx"/>
            <field-result name="accPk"       column="atr_acc_pk"/>
            <field-result name="atPk"        column="atr_at_pk"/>
            <field-result name="amt"         column="atr_amt"/>
            <field-result name="prevBalance" column="atr_prev_balance"/>
            <field-result name="desc"        column="atr_desc"/>
            <field-result name="refCode"     column="atr_ref_code"/>
            <field-result name="refCode2"    column="atr_ref_code2"/>
            <field-result name="refCode3"    column="atr_ref_code3"/>
            <field-result name="refCode4"    column="atr_ref_code4"/>
            <field-result name="memo"        column="atr_memo"/>
            <field-result name="crlId"       column="atr_crl_id"/>
            <field-result name="reqId"       column="atr_req_id"/>
            <field-result name="uid"         column="atr_uid"/>
            <field-result name="amtIncoming" column="atr_amt_incoming"/>
            <field-result name="ccyIncoming" column="atr_ccy_incoming"/>
            <field-result name="convRate"    column="atr_conv_rate"/>
        </entity-result>
    </sql-result-set-mapping>

</entity-mappings>
