    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
        				<executions>
        					<execution>
        						<goals>
        							<goal>repackage</goal>
        						</goals>
        					</execution>
        				</executions>                        
                </plugin>

    			<plugin>
    				<groupId>org.apache.maven.plugins</groupId>
    				<artifactId>maven-resources-plugin</artifactId>
    				<version>3.3.1</version>
    			</plugin>
			                
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.version}</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <release>${maven.compiler.release}</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Tests skip the REQUIRED shared-topology import: a missing file is fine here (a context
                         test that needs the catalog supplies it via MockEnvironment / @DynamicPropertySource).
                         docker / k8s keep the required default (file:/etc/esquire/topology.yml). -->
                    <systemPropertyVariables>
                        <TOPOLOGY_IMPORT>optional:file:/etc/esquire/topology.yml</TOPOLOGY_IMPORT>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Code coverage: prepare-agent instruments the forked test JVM (surefire), so ALL tests that
                 run in that JVM are measured together: the unit tests AND the in-JVM Testcontainers /
                 @SpringBootTest integration tests (the *IntegrationTest classes). One combined report per
                 module at target/site/jacoco/index.html. e2e (Playwright) and hauberk exercise a separately
                 deployed stack (other JVMs) and are out of this report's reach by design. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <!-- Write every module's report into one sibling folder,
                                 services/test/JaCoCo/<artifactId>, DELIBERATELY outside the module
                                 target/ so `mvn clean` does NOT wipe the collected coverage. The
                                 test/JaCoCo/framed.html dashboard browses these. All Esquire modules
                                 are direct children of services. -->
                            <outputDirectory>${project.basedir}/../test/JaCoCo/${project.artifactId}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

