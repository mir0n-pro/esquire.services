<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="http://java.sun.com/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/persistence/orm http://java.sun.com/xml/ns/persistence/orm_2_0.xsd"
    version="2.0">
<!--
        <query><![CDATA[ ]]>
-->
    <named-native-query name="EsqEntityJpa.detailOrg"  result-set-mapping="EsqOrgJpaMapping">
        <query>
 SELECT org_pk as "pk"
     ,org_et_pk  as "kind"
     ,org_name as "name"
     ,org_desc as "desc"
     ,org_full_name
 FROM esq_org
 WHERE org_pk = :id
 AND org_path LIKE :rootPath || '%'
        </query>
    </named-native-query>

    <named-native-query name="EsqEntityJpa.detailUsr"  result-set-mapping="EsqUsrJpaMapping">
        <query>
 SELECT usr_pk as "pk"
     ,usr_et_pk as "kind"
     ,usr_name as "name"
     ,usr_desc as "desc"
     ,au_login_id
     ,usr_reg_option
     ,usr_deleted_flg
     ,au_email
 FROM esq_user, esq_auth
 WHERE usr_pk = :id
 AND usr_pk = au_usr_pk
 AND usr_path LIKE :rootPath || '%'
        </query>
    </named-native-query>

    <named-native-query name="EsqEntityJpa.acctsAsNodes" result-set-mapping="EsqAccNodeJpaMapping">
        <query>
 SELECT acc_pk AS tree_pk
    ,acc_usr_pk
    ,NULL as pk_link
    ,acc_id
    ,acc_et_pk
    ,DECODE(acc_status,'C',1,'L',2,0) as status_code
    ,acc_pk
    ,'b' AS tree_flgs
    ,-1 AS tree_level
    ,acc_desc
    ,acc_path
 FROM esq_account
 WHERE acc_usr_pk = :id
 AND acc_path LIKE :rootPath || '%'
        </query>
    </named-native-query>

    <sql-result-set-mapping name="EsqUsrJpaMapping">
        <entity-result entity-class="pro.mir0n.esquire.backend.jpa.entity.EsqUsrJpa">
            <field-result name="id" column="pk"/>
            <field-result name="kind" column="kind"/>
            <field-result name="name" column="name"/>
            <field-result name="desc" column="desc"/>
            <field-result name="loginId" column="au_login_id"/>
            <field-result name="registration" column="usr_reg_option"/>
            <field-result name="deleted" column="usr_deleted_flg"/>
            <field-result name="email" column="au_email"/>
        </entity-result>
    </sql-result-set-mapping>

    <sql-result-set-mapping name="EsqOrgJpaMapping">
        <entity-result entity-class="pro.mir0n.esquire.backend.jpa.entity.EsqOrgJpa">
            <field-result name="id" column="pk"/>
            <field-result name="kind" column="kind"/>
            <field-result name="name" column="name"/>
            <field-result name="desc" column="desc"/>
            <field-result name="fullName" column="org_full_name"/>
        </entity-result>
    </sql-result-set-mapping>

    <sql-result-set-mapping name="EsqAccNodeJpaMapping">
        <entity-result entity-class="pro.mir0n.esquire.backend.jpa.EsqTreeNodeJpa">
            <field-result name="id" column="tree_pk"/>
            <field-result name="name" column="acc_id"/>
            <field-result name="entityId" column="acc_pk"/>
            <field-result name="kind" column="acc_et_pk"/>
            <field-result name="parentId" column="acc_usr_pk"/>
            <field-result name="linkId" column="pk_link"/>
            <field-result name="statusCode" column="status_code"/>
            <field-result name="treeFlags" column="tree_flgs"/>
            <field-result name="level" column="tree_level"/>
            <field-result name="desc" column="acc_desc"/>
            <field-result name="path" column="acc_path"/>
        </entity-result>
    </sql-result-set-mapping>

</entity-mappings>
