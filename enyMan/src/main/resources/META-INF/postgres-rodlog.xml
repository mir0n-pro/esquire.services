<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="http://java.sun.com/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/persistence/orm http://java.sun.com/xml/ns/persistence/orm_2_0.xsd"
    version="2.0">
<!--
    x-Rod param audit support (option b), Postgres. Re-SELECTs the committed *_par rows (source of
    truth) so the producer can emit one full ORG_PAR / USR_PAR event per row (value + the param's own
    et_pk). The *_log writes themselves are done by common.audit.AuditLogWriter (vendor-keyed
    AuditLogSql), NOT by named queries here.
-->

    <named-native-query name="EsqOrgJpa.listOrgPar" result-set-mapping="EsqParRowMapping">
        <query>
 SELECT opr_par_name AS "name", opr_par_et_pk AS "etPk", opr_value AS "value"
 FROM esq_org_par
 WHERE opr_org_pk = CAST(:id AS bigint)
        </query>
    </named-native-query>

    <named-native-query name="EsqUsrJpa.listUsrPar" result-set-mapping="EsqParRowMapping">
        <query>
 SELECT upr_par_name AS "name", upr_par_et_pk AS "etPk", upr_value AS "value"
 FROM esq_usr_par
 WHERE upr_usr_pk = CAST(:id AS bigint)
        </query>
    </named-native-query>

    <sql-result-set-mapping name="EsqParRowMapping">
        <entity-result entity-class="pro.mir0n.esquire.backend.jpa.entity.EsqParRow">
            <field-result name="name"  column="name"/>
            <field-result name="etPk"  column="etPk"/>
            <field-result name="value" column="value"/>
        </entity-result>
    </sql-result-set-mapping>

</entity-mappings>
