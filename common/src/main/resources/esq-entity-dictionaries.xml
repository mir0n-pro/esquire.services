                            <!-- nullable></nullable -->
                            <!-- nullmeaning></nullmeaning -->
                            <!-- validation></validation -->
                            <!-- format></format -->
                        </field>
                        <field>
                            <name>fullName</name>
                            <sort>2</sort>
                            <label>Full Name</label>
                            <type>string</type>
                            <tooltip>Organization full name</tooltip>
                            <nullable>Y</nullable>
                            <readwrite>3</readwrite>
                            <minmax>200</minmax>
                        </field>
                    </fields>
                </layer>
                <layer>
                    <layer>99</layer>
                    <title>Description</title>
                    <fields>
                        <field>
                            <name>desc</name>
                            <sort>1</sort>
